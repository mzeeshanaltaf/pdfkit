NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Umami analytics (optional; unset means no tracker renders) -------------
# Baked in at build time. From your self-hosted Umami instance's website settings.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
MAX_UPLOAD_MB=50
MAX_CONCURRENT_JOBS=2

# --- API token, shared by both services -------------------------------------
# One value, read by the frontend's /api/token (which mints) and the backend
# (which verifies). Generate with: openssl rand -hex 32
# Unset, the API accepts unauthenticated requests and /health reports "auth":"off".
# This is a cost gate, not a security boundary — see backend/app/services/auth.py.
API_TOKEN_SECRET=
# Verify-only. Set this to the outgoing value for one deploy when rotating.
API_TOKEN_SECRET_PREVIOUS=
# Docker bridge ranges Traefik connects from. Without this, uvicorn distrusts the
# proxy headers and every visitor shares one rate-limit bucket.
FORWARDED_ALLOW_IPS=172.16.0.0/12,10.0.0.0/8

# --- Daytona offload (optional; unset = everything runs on the VPS) ---------
# Moves the CPU-heavy operations into a per-request sandbox, so a 2 vCPU box
# shared with 18 other apps is not the thing grinding through a 50-page scan.
# Off unless DAYTONA_ENABLED=true, and everything below is inert while it is.
DAYTONA_ENABLED=false
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=eu
# Built by .github/workflows/snapshot.yml, whose name is a content hash of
# backend/Dockerfile + pyproject.toml + uv.lock: pdfkit-toolchain-<12 hex>.
# Take the name from that workflow's run summary and set it here BY HAND after
# a toolchain change - nothing updates it automatically, so a dependency bump
# that has not been snapshotted falls back to the VPS instead of silently
# running a stale toolchain. Daytona's stock snapshots carry no Ghostscript,
# Tesseract or OCRmyPDF, so nothing of ours can run on one.
# `cd backend && python scripts/build_snapshot.py --print-name` prints the
# name this checkout's toolchain should be under.
DAYTONA_SNAPSHOT=pdfkit-toolchain
# Only operations with an offload head. All four have one; listed in
# compute-per-byte order, which is documentation - membership is all that
# is tested.
DAYTONA_OPERATIONS=ocr,word,markdown,compress
# The most sandboxes this process may have alive at once. It is also the most
# a single batch is split across, so one large batch can take them all and
# leave a request arriving behind it to run on the VPS.
DAYTONA_MAX_SANDBOXES=2
# Read only when BUILDING the snapshot: Daytona fixes a sandbox's resources at
# snapshot-build time and rejects them on the per-sandbox create.
DAYTONA_SANDBOX_CPU=4
DAYTONA_SANDBOX_MEMORY_GB=4
DAYTONA_SANDBOX_DISK_GB=10
# What makes a batch worth the ~2.5 s round trip. The file count does the real
# gating; the byte floor just stops one tiny file paying provisioning latency.
DAYTONA_MIN_FILES=2
DAYTONA_MIN_BYTES=5242880
DAYTONA_PROVISION_TIMEOUT_SECONDS=150
# Added to the operation's normal timeout to get the remote batch's budget.
DAYTONA_OVERHEAD_SECONDS=90
# Backstops against a sandbox outliving a VPS that died mid-request.
DAYTONA_AUTO_STOP_MINUTES=5
DAYTONA_TTL_MINUTES=30
# false makes every Daytona failure a visible 502 instead of a silent local
# retry - useful during rollout for telling Daytona faults from document ones.
DAYTONA_FALLBACK_LOCAL=true

# --- Sandbox telemetry (optional; unset on either side = feature off) -------
# The backend posts one record per shard (sandbox id, operation, alive-time,
# resources) to the frontend's /api/stats/sandbox over the internal Docker
# network, so the admin dashboard can report Daytona's own cost without
# waiting on its Spending dashboard, which lags real consumption by up to 48
# hours. Read by the backend as STATS_INGEST_URL/STATS_INGEST_SECRET and by
# the frontend as STATS_INGEST_SECRET - same secret, both sides.
STATS_INGEST_URL=http://frontend:3000/api/stats/sandbox
STATS_INGEST_SECRET=
# Read-only Daytona API access for the admin dashboard's "live now" quota
# strip. Reuses the same account/key as DAYTONA_API_KEY/DAYTONA_API_URL above,
# just read by the frontend service this time.
# Overrides Daytona's published per-second rates the dashboard's cost estimate
# is built from. Unset, the built-in defaults apply.
DAYTONA_PRICE_CPU_HOUR=
DAYTONA_PRICE_RAM_GB_HOUR=
DAYTONA_PRICE_DISK_GB_HOUR=

# --- Contact form, read by the frontend service (server-only) ---
N8N_CONTACT_WEBHOOK_URL=
N8N_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin dashboard (/admin), read by the frontend service (server-only) ---
# Unset DATABASE_URL and the feature degrades quietly instead of breaking anything.
DATABASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
STATS_SALT=
STATS_RETENTION_DAYS=365
