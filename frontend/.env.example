NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form (server-only; never prefix these with NEXT_PUBLIC_) ---
# n8n webhook the /contact form forwards submissions to
N8N_CONTACT_WEBHOOK_URL=
# Sent as the x-api-key header so n8n can authenticate the call
N8N_API_KEY=

# Upstash Redis REST credentials for per-IP rate limiting on /api/contact and
# /api/token. Optional: with these unset the limiter fails open and both still work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs the short-lived tokens /api/token mints for the PDF API. Must be the same
# value the backend verifies with. Read at request time, so never NEXT_PUBLIC_ and
# never a build arg — rotating it needs no rebuild.
API_TOKEN_SECRET=
