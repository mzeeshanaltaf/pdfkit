NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Umami analytics (optional; unset means no tracker renders) -------------
# Baked in at build time. From your self-hosted Umami instance's website settings.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Contact form (server-only; never prefix these with NEXT_PUBLIC_) ---
# n8n webhook the /contact form forwards submissions to
N8N_CONTACT_WEBHOOK_URL=
# Sent as the x-api-key header so n8n can authenticate the call
N8N_API_KEY=

# Upstash Redis REST credentials for per-IP rate limiting on /api/contact and
# /api/token. Optional: with these unset the limiter fails open and both still work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs the short-lived tokens /api/token mints for the PDF API. Must be the same
# value the backend verifies with. Read at request time, so never NEXT_PUBLIC_ and
# never a build arg — rotating it needs no rebuild.
API_TOKEN_SECRET=

# --- Admin dashboard (/admin) ------------------------------------------------
# Anonymous per-run counters, password-gated. Unset DATABASE_URL and the whole
# feature degrades quietly: the stats API no-ops, the dashboard shows a
# "not configured" panel. All of these are runtime env, read per request.
#
# Next reads env from the app dir, so if DATABASE_URL already lives in a
# repo-root .env.local it must also be added here.
DATABASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# openssl rand -hex 32
ADMIN_SESSION_SECRET=
# openssl rand -hex 32 — salts the daily-rotating visitor hash (never an IP)
STATS_SALT=
STATS_RETENTION_DAYS=365
